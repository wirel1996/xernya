<div class="col-sm-12 my-auto">
  <h2 style="color: #800100; margin: auto">Edit <%= @item.name.camelize %></h2>
  <br/>
  
  <%= simple_form_for @item do |f| %>
    <div class="form-group row">
      <div class="col-sm-10">
        <%= f.input :name, input_html: { class: "form-control form-control-sm", id: "colFormLabelSm" } %>
      </div>
    </div>

    <div class="col-sm-10">
      <%= f.input :price, input_html: { class: "form-control form-control-sm" }, required: true %>
    </div>

    <div class="col-sm-10">
      <%= f.input :description, label: t("Item.description"), 
                  input_html: {class: "form-control form-control-sm",
                               id: "colFormLableSM"} %>
    </div>

    <div class="col-sm-10">
      <%= f.button :submit, class: "btn btn-secondary", style: "margin-top: 15px" %>
    </div>
</div>
  <% end %>
  <%= render partial: 'shared/email' %>